PORT=3001
JWT_SECRET=replace-with-a-long-random-secret
DATABASE_PATH=./data/messenger.sqlite
CORS_ORIGIN=http://localhost:5173
# Comma-separated, case-insensitive email domains. Empty means any domain.
ALLOWED_EMAIL_DOMAINS=
# Every account and conversation is isolated to this scope.
COMPANY_ID=default-company
EVENT_ID=default-event
JWT_EXPIRES_IN=7d
