{
  "name": "msnmessenger",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:local": "VITE_BACKEND_URL=http://localhost:3309 VITE_WEBSOCKET_URL=ws://localhost:3309/ws VITE_ENABLE_EMAIL_AUTH=true VITE_ENABLE_WINAMP=true VITE_ENABLE_LISTENING=true vite --host localhost --port 5179 --strictPort",
    "server:local": "bash scripts/local-db.sh server",
    "db:local": "bash scripts/local-db.sh start",
    "db:local:stop": "bash scripts/local-db.sh stop",
    "build": "vite build",
    "lint": "eslint . --ext js,jsx --report-unused-disable-directives --max-warnings 0",
    "preview": "vite preview",
    "server": "npm --prefix server start",
    "server:dev": "npm --prefix server run dev",
    "format": "prettier --write .",
    "test:music": "node --test server/music.test.js src/features/winamp/YouTubeMediaAdapter.test.js src/features/winamp/sharedPlaylistSync.test.js src/features/listening/state.test.js"
  },
  "dependencies": {
    "@azure/msal-browser": "^5.22.0",
    "@ruffle-rs/ruffle": "^0.1.0-nightly.2024.12.15",
    "7.css": "^0.16.0",
    "axios": "^1.7.9",
    "color-thief-react": "^1.0.2",
    "colorthief": "^2.4.0",
    "cors": "^2.8.5",
    "crypto-js": "^4.2.0",
    "dotenv": "^16.4.7",
    "express": "^4.19.2",
    "jose": "^6.2.12",
    "openai": "^4.47.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-dotenv": "^0.1.3",
    "react-image-crop": "^11.0.5",
    "react-router-dom": "^6.23.1",
    "webamp": "2.3.1",
    "zustand": "^4.5.2"
  },
  "devDependencies": {
    "@types/react": "^18.2.66",
    "@types/react-dom": "^18.2.22",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.19",
    "eslint": "^8.57.0",
    "eslint-plugin-react": "^7.34.1",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.6",
    "postcss": "^8.4.38",
    "tailwindcss": "^3.4.3",
    "vite": "^5.2.0"
  }
}
